		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
