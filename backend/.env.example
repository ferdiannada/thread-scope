# ==============================================================================
# ThreadScope - Sentiment Intelligence Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thread_scope

# Sentiment Engine Configuration ("indobert", "gemini", or "hybrid")
SENTIMENT_ENGINE=indobert
INDOBERT_MODEL_NAME=ayameRushia/bert-base-indonesian-1.5G-sentiment-analysis-smsa

# Gemini API Key (Opsional jika menggunakan engine IndoBERT)
# Dapatkan API key di: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta Threads Official API (Opsional: jika memiliki developer app)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=

# Sesi Login Threads / Instagram (Opsional)
# Masukkan nilai cookie 'sessionid' dari browser (DevTools) untuk scraping live tanpa rate limit
THREADS_SESSION_ID=

# Scraper Settings
PLAYWRIGHT_HEADLESS=true
